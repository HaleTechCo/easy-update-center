# Copy to .env. Online: by default the generator reads repo.jenkins-ci.org (a free Jenkins community
# account is required) and downloads redirect to get.jenkins.io.
# Every setting: docs/reference/configuration.md
MODE=online
PUBLIC_URL=https://jenkins-updates.example.com
# GENERATE_SCHEDULE=0 */6 * * *
# RESOURCES_REF=master
# Tiers for cores released within this many days (0: every core a plugin requires):
# CORE_AGE_DAYS=400
# JAVA_TOOL_OPTIONS=-Xmx4g -Dhttps.proxyHost=proxy.example.com -Dhttps.proxyPort=3128
# Behind a proxy, the uc code needs it too (JAVA_TOOL_OPTIONS reaches the generator only):
# HTTPS_PROXY=http://proxy.example.com:3128
# NO_PROXY=repo-adapter
# HTTP_PORT=8080
# Your own Artifactory or Artifact Keeper instead of repo.jenkins-ci.org, with secrets/repo_* holding
# its account (docs/architecture/modes.md#your-own-repository):
# REPO_TYPE=artifact-keeper
# REPO_URL=https://artifacts.corp.example/
# REPO_KEY=jenkins-plugins-local
# DOWNLOAD_BACKEND=artifactory
# DOWNLOAD_ACCESS=proxy
# CORE_AGE_DAYS=0
