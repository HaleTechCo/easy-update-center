# Local configuration and secrets. Keep these first: nothing below may re-include them.
# Any copy of .env (.env.backup, .env.airgapped, ...) holds real credentials; only the
# committed examples are kept.
.env
.env.*
!.env.*.example
data/
secrets/*
!secrets/README.md
# A PKI made on this host with `setup pki-init --out` (docs/reference/cli.md) holds a root CA's
# private key: keep it out of git. Make a production PKI on an offline machine instead
# (docs/how-to/rotate-signing-certificate.md#create-the-pki-on-an-offline-machine).
newpki/

# A TLS certificate and key mounted into web (docs/how-to/enable-tls.md): the key is private.
tls/

# Files staged for review by uc procure stage and record (docs/how-to/procure-missing-files.md)
procurement/*
!procurement/README.md

# Integration-test scratch (make it-airgapped, make it-online)
tests/integration/.versions.env
tests/integration/.results/

# Python: the parts of github/gitignore's Python.gitignore that apply here. uc is
# stdlib-only and its tests run in containers; editors and ad-hoc runs on the host
# still write these.
__pycache__/
*.py[cod]
.pytest_cache/

# Lint tooling (pre-commit; see CONTRIBUTING.md#set-up): a venv for pre-commit, under any of
# the names .pre-commit-config.yaml excludes (.venv, .venv313, venv, ...), and ruff's cache at
# the root. pre-commit keeps the hooks' environments outside the tree.
.venv*/
venv*/
.ruff_cache/
