From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Zachary Hale <zacharyshale95@gmail.com>
Date: Sat, 17 Oct 2026 16:00:00 -0700
Subject: [PATCH] Update libraries with known vulnerabilities

Raise the libraries scanners flag in 3.18.4 to their fixed releases:
bouncycastle 1.80.2 to 1.85, owasp-java-html-sanitizer 20240325.1 to
20260101.1 and jsoup 1.19.1 to 1.23.2, and pin commons-beanutils (which
json-lib brings at 1.9.4) to 1.11.0, with the commons-logging 1.3.5 it
needs. Drop a line once upstream ships it.

---
diff --git a/pom.xml b/pom.xml
index b99d79e..a5ccb47 100644
--- a/pom.xml
+++ b/pom.xml
@@ -20,7 +20,7 @@
     <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
     <project.build.outputEncoding>UTF-8</project.build.outputEncoding>
     <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
-    <bouncycastle.version>1.80.2</bouncycastle.version>
+    <bouncycastle.version>1.85</bouncycastle.version>
   </properties>
 
   <build>
@@ -104,6 +104,22 @@
     </plugins>
   </build>
 
+  <dependencyManagement>
+    <dependencies>
+      <!-- json-lib brings 1.9.4; 1.11.0 needs commons-logging 1.3.5 -->
+      <dependency>
+        <groupId>commons-beanutils</groupId>
+        <artifactId>commons-beanutils</artifactId>
+        <version>1.11.0</version>
+      </dependency>
+      <dependency>
+        <groupId>commons-logging</groupId>
+        <artifactId>commons-logging</artifactId>
+        <version>1.3.5</version>
+      </dependency>
+    </dependencies>
+  </dependencyManagement>
+
   <dependencies>
     <dependency>
       <groupId>org.jvnet.hudson</groupId>
@@ -179,7 +195,7 @@
     <dependency>
       <groupId>com.googlecode.owasp-java-html-sanitizer</groupId>
       <artifactId>owasp-java-html-sanitizer</artifactId>
-      <version>20240325.1</version>
+      <version>20260101.1</version>
     </dependency>
     <dependency>
       <groupId>com.github.spotbugs</groupId>
@@ -190,7 +206,7 @@
     <dependency>
       <groupId>org.jsoup</groupId>
       <artifactId>jsoup</artifactId>
-      <version>1.19.1</version>
+      <version>1.23.2</version>
     </dependency>
 
     <!-- test dependencies -->
