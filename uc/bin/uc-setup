#!/bin/sh
# The setup service's entrypoint (compose.yaml; docs/reference/cli.md#the-setup-service): first-time
# setup and the jobs that write to ./secrets and ./procurement, as root, with no network.
#   (no argument)   secrets, pki-init unless a signing key exists, then procurement (the one step
#                   that can fail on some filesystems, so it comes last)
#   secrets         create the missing credential files empty; set the permissions
#   procurement     share ./procurement between you and the uc containers (ACLs)
#   pki-init [--out DIR] [--display-dir NAME]   a new root CA and signing certificate; in secrets/,
#                                               then the secrets step
#   pki-rotate [--root-display-dir NAME]        a new signing certificate, then the secrets step;
#                                               the root key mounted read-only at /setup/secrets/root
set -eu

here=$(dirname "$0")
secrets=/setup/secrets
procurement=/setup/procurement
config=/setup/config
uc_uid=10001
credential_files="repo_username repo_password github_username github_token download_proxy_auth repo_push_auth"

usage() {
    echo "usage: uc-setup [secrets | procurement | pki-init [--out DIR] [--display-dir NAME] | pki-rotate [--root-display-dir NAME]]" >&2
    exit 2
}
die() {
    echo "uc-setup: error: $*" >&2
    exit 1
}

# The host user owns ./config in every checkout. ./secrets and ./procurement cannot tell: Docker
# creates a missing bind-mount directory as root.
owner() { stat -c %u:%g "${config}"; }

checkout() { # refuse to run when Docker created ./config too: then it is no checkout, and nobody owns it
    uid=$(stat -c %u "${config}")
    entries=$(ls -A "${config}")
    if [ "${uid}" = 0 ] && [ -z "${entries}" ]; then
        die "config/ is empty and owned by root, so Docker just created it: this is not a checkout of jenkins-update-center, and setup cannot tell whose secrets/ and procurement/ are. Run it in your checkout (where config/ holds uc.example.toml), or create config/ as yourself first"
    fi
}

claim() { # claim DIR - give DIR to the host user when Docker just created it (owned by root, empty)
    uid=$(stat -c %u "$1")
    entries=$(ls -A "$1")
    if [ "${uid}" = 0 ] && [ -z "${entries}" ]; then
        ids=$(owner)
        chown "${ids}" "$1"
    fi
}

fix_secrets() { # fix_secrets DIR
    ids=$(owner)
    sh "${here}/secrets-permissions.sh" "$1" "${ids%%:*}" "${ids##*:}"
}

do_secrets() {
    for file in ${credential_files}; do
        [ -e "${secrets}/${file}" ] || : > "${secrets}/${file}"
    done
    fix_secrets "${secrets}"
    echo "secrets/: created any missing credential files (empty means 'not set'); the containers read their files through their group"
}

do_procurement() {
    ids=$(owner)
    chown "${ids}" "${procurement}"
    acl="u:${ids%%:*}:rwX,u:${uc_uid}:rwX,m::rwX"
    # ACLs on procurement/ itself first: when that fails, the filesystem has none, and nothing is set.
    # shellcheck disable=SC2016 # $1 is expanded by the sh that setpriv runs
    if setfacl -m "${acl}" "${procurement}" 2> /dev/null; then
        # Then the whole tree, and defaults on every directory in it (-P: symbolic links are skipped).
        if ! failed=$(setfacl -R -P -m "${acl}" -d -m "${acl}" "${procurement}" 2>&1); then
            die "procurement/ is only partly shared with the uc containers (run setup procurement again once this is fixed): ${failed}"
        fi
        echo "procurement/: shared with the uc containers; you can review, edit, move and delete every file in it"
    elif setpriv --reuid="${uc_uid}" --regid="${uc_uid}" --clear-groups \
        sh -c 'touch "$1/.uc-setup-check" && rm "$1/.uc-setup-check"' sh "${procurement}" 2> /dev/null; then
        echo "procurement/: uid 10001 (the uc containers) can already write it; nothing to do"
    else
        die "this filesystem does not support ACLs, so procurement/ cannot be shared with the uc containers: use make procure-stage, procure-record and procure-clean, which hand it over for each run"
    fi
}

do_pki_init() {
    out=${secrets}
    shown=secrets
    while [ $# -gt 0 ]; do
        [ $# -ge 2 ] || usage
        case $1 in
            --out) out=$2 ;;
            --display-dir) shown=$2 ;;
            *) usage ;;
        esac
        shift 2
    done
    uc pki init --out "${out}" --display-dir "${shown}"
    if [ "${out}" = "${secrets}" ]; then
        do_secrets
    else
        fix_secrets "${out}" # a new PKI elsewhere: no credential files there
    fi
}

do_pki_rotate() {
    root_shown=secrets/root
    while [ $# -gt 0 ]; do
        [ $# -ge 2 ] || usage
        case $1 in
            --root-display-dir) root_shown=$2 ;;
            *) usage ;;
        esac
        shift 2
    done
    [ -d "${secrets}/root" ] || die "the root key is not mounted: run make pki-rotate ROOT=<directory holding root-ca.key>, or mount that directory read-only at /setup/secrets/root yourself: docker compose run --rm -v /path/to/root:/setup/secrets/root:ro setup pki-rotate"
    uc pki rotate --dir "${secrets}" --display-dir secrets --root-display-dir "${root_shown}"
    do_secrets
}

checkout
claim "${secrets}"
claim "${procurement}"
command=${1:-}
[ $# -eq 0 ] || shift
case ${command} in
    '')
        [ $# -eq 0 ] || usage
        do_secrets
        if [ -e "${secrets}/update-center.key" ]; then
            echo "secrets/: the signing keys exist; left as they are (pki-rotate issues a new certificate)"
        else
            uc pki init --out "${secrets}" --display-dir secrets
            fix_secrets "${secrets}" # the secrets step just ran: only the new files need their permissions
        fi
        do_procurement
        ;;
    secrets)
        [ $# -eq 0 ] || usage
        do_secrets
        ;;
    procurement)
        [ $# -eq 0 ] || usage
        do_procurement
        ;;
    pki-init) do_pki_init "$@" ;;
    pki-rotate) do_pki_rotate "$@" ;;
    *) usage ;;
esac
