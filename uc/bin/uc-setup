#!/bin/sh
# The setup service's entrypoint (compose.yaml; docs/reference/cli.md#the-setup-service): first-time
# setup and the jobs that write to ./secrets, run as UC_UID:UC_GID like every other service, with no
# network.
#   (no argument)   secrets, then pki-init unless a signing key exists
#   secrets         create the missing credential files empty; set the modes
#   pki-init [--out DIR] [--org ORG] [--root-days N] [--signing-days N]
#                   a new root CA and signing certificate in secrets/ (then the secrets step), or in DIR
#   pki-rotate [--days N] [--org ORG]
#                   a new signing certificate from the root key mounted read-only at /setup/root, then the
#                   secrets step
set -eu

secrets=/setup/secrets
root=/setup/root
credential_files="repo_username repo_password github_username github_token download_proxy_auth repo_push_auth"

usage() {
    echo "usage: uc-setup [secrets | pki-init [--out DIR] [--org ORG] [--root-days N] [--signing-days N] | pki-rotate [--days N] [--org ORG]]" >&2
    exit 2
}
die() {
    echo "uc-setup: error: $*" >&2
    exit 1
}
warn_root_key() { # warn while the root CA's key is on this host
    if [ -e "${secrets}/root/root-ca.key" ]; then
        echo "uc-setup: warning: secrets/root/root-ca.key is on this host: anyone who holds it can sign metadata every controller accepts. Move secrets/root/ to offline storage (docs/how-to/rotate-signing-certificate.md#where-the-root-key-lives)" >&2
    fi
}
# Every run warns, the ones that stop on an error or a usage mistake too, and last, so the run that
# creates the key warns as well. The exit status stays the run's.
trap warn_root_key EXIT

uid="$(id -u)"
[ "${uid}" != 0 ] || die "setup must not run as root: set UC_UID and UC_GID in .env to your own user (id -u, id -g)"

writable() { # writable DIR LABEL - stop unless this uid can create files in DIR
    if ! (: > "$1/.uc-setup-check") 2> /dev/null; then
        uid=$(id -u)
        die "$2 is not writable by uid ${uid}: set UC_UID and UC_GID in .env to the output of id -u and id -g"
    fi
    rm -f "$1/.uc-setup-check"
}

foreign() { # foreign PATH - stop: PATH belongs to another user, so this uid cannot set its mode
    uid=$(id -u)
    die "${1#/setup/} belongs to another user than uid ${uid}: give it to yours (sudo chown), or set UC_UID and UC_GID in .env to its owner"
}

set_modes() { # set_modes DIR - keys and credentials 0600, certificates 0644, root/ 0700 and its files 0600
    for name in update-center.key update-center.key.old ${credential_files}; do
        if [ -f "$1/${name}" ]; then chmod 0600 "$1/${name}" 2> /dev/null || foreign "$1/${name}"; fi
    done
    for name in update-center.cert update-center.cert.old root-ca.crt repo-ca.crt proxy-ca.crt; do
        if [ -f "$1/${name}" ]; then chmod 0644 "$1/${name}" 2> /dev/null || foreign "$1/${name}"; fi
    done
    if [ -d "$1/root" ] && [ -w "$1/root" ]; then
        chmod 0700 "$1/root" 2> /dev/null || foreign "$1/root"
        find "$1/root" -type f -exec chmod 0600 {} + 2> /dev/null || foreign "$1/root/root-ca.key"
    fi
}

check_options() { # check_options "ALLOWED..." ARG... - every ARG is an allowed option followed by a value
    allowed=" $1 "
    shift
    while [ $# -gt 0 ]; do
        [ $# -ge 2 ] || usage
        case ${allowed} in *" $1 "*) ;; *) usage ;; esac
        shift 2
    done
}

out_dir() { # out_dir ARG... - print the value of --out, if given
    while [ $# -ge 2 ]; do
        if [ "$1" = --out ]; then
            echo "$2"
            return
        fi
        shift 2
    done
}

clear_stale_init() { # clear_stale_init DIR - remove what a killed pki init left: .init-* folders, which can hold a root key
    for stale in "$1"/.init-*; do
        [ -e "${stale}" ] || continue
        rm -rf "${stale}"
        echo "uc-setup: removed ${stale#/setup/}, left by an interrupted pki init"
    done
}

do_secrets() {
    writable "${secrets}" secrets/
    for file in ${credential_files}; do
        [ -e "${secrets}/${file}" ] || : > "${secrets}/${file}"
    done
    set_modes "${secrets}"
    echo "secrets/: created any missing credential files (empty means 'not set') and set the modes"
}

do_pki_init() {
    check_options "--out --org --root-days --signing-days" "$@"
    out=$(out_dir "$@")
    if [ -z "${out}" ]; then
        writable "${secrets}" secrets/
        clear_stale_init "${secrets}"
        uc pki init --out "${secrets}" --display-dir secrets "$@"
        do_secrets
    else
        writable "${out}" "${out}"
        clear_stale_init "${out}"
        uc pki init "$@"
        set_modes "${out}" # a new PKI elsewhere: no credential files there
    fi
}

do_pki_rotate() {
    check_options "--days --org" "$@"
    [ -e "${root}" ] || die "the root key is not mounted: docker compose run --rm -v <folder holding root-ca.key>:/setup/root:ro setup pki-rotate"
    [ -d "${root}" ] || die "/setup/root is a file: mount the folder that holds root-ca.key, not the key itself"
    writable "${secrets}" secrets/
    uc pki rotate --dir "${secrets}" --root "${root}" --display-dir secrets "$@"
    do_secrets
}

refuse_directories() { # stop on a directory where setup keeps a secret file
    # Docker creates an empty directory at every missing bind-mount path when a container starts
    # before setup, and a directory there would pass the "exists" checks below.
    # root-ca.crt is a Compose secret of uc and scheduler, so it becomes a directory the same way.
    # Name every offender, so one run shows all of them.
    bad=0
    for name in update-center.key update-center.cert root-ca.crt ${credential_files}; do
        if [ -d "${secrets}/${name}" ]; then
            echo "uc-setup: error: secrets/${name} is a directory, not a file: Docker creates one when a container starts before setup; remove it and run setup again" >&2
            bad=1
        fi
    done
    [ "${bad}" -eq 0 ] || exit 1
}

refuse_directories

command=${1:-}
[ $# -eq 0 ] || shift
case ${command} in
    '')
        [ $# -eq 0 ] || usage
        do_secrets
        if [ -e "${secrets}/update-center.key" ]; then
            echo "secrets/: the signing keys exist; left as they are (pki-rotate issues a new certificate)"
        else
            clear_stale_init "${secrets}"
            uc pki init --out "${secrets}" --display-dir secrets
            set_modes "${secrets}"
        fi
        ;;
    secrets)
        [ $# -eq 0 ] || usage
        do_secrets
        ;;
    pki-init) do_pki_init "$@" ;;
    pki-rotate) do_pki_rotate "$@" ;;
    *) usage ;;
esac
