# Settings for the update center in airgapped mode, one variable per setting. Copy this file to .env and
# edit the copy; a line starting with # is not set: it shows the default or an example value, and the
# comment above it says what applies when it is unset. Remove the # to set it.
# Air-gapped, the generator reads your repository through the repo-adapter
# (docs/how-to/stock-airgapped-repository.md), and controllers download from it.
# Generated from the settings registry: `uc config --example env --mode airgapped` (make examples).
# Any of these can go in config/uc.toml instead (config/uc.example.toml); a variable here wins over it.
# Every setting: docs/reference/configuration.md

# ---- Required ----
# online or airgapped. It only sets defaults; every other setting can still be set explicitly.
MODE=airgapped
# The exact origin Jenkins uses, with no path.
PUBLIC_URL=https://jenkins-updates.example.com

# ---- Source repository ----
# artifactory or artifact-keeper. Artifact Keeper is read only through the repo-adapter.
# REPO_TYPE=artifactory
# Artifactory: the /artifactory/ base URL; Artifact Keeper: the server's base URL. It defaults to https://repo.jenkins-ci.org/ only online with REPO_TYPE=artifactory.
REPO_URL=https://artifactory.corp.example/artifactory/
# Artifactory's API base for the listing query, ${REPO_URL}api/ by default. Set it only when the API is served elsewhere.
# REPO_API_URL=
# The repository key (for Artifact Keeper, the key, not the display name). It defaults to releases only online with REPO_TYPE=artifactory.
REPO_KEY=jenkins-plugins-local

# ---- repo-adapter ----
# Read the repository through the repo-adapter: on by default air-gapped and always with Artifact Keeper, off otherwise.
# REPO_ADAPTER=true
# Where uc finds the repo-adapter, http://repo-adapter:${REPO_ADAPTER_PORT}/artifactory/ by default. Change it only with a non-default Compose layout.
# REPO_ADAPTER_URL=
# The repo-adapter's token, cache and report.json, ${UC_DATA_DIR}/repo-adapter by default.
# REPO_ADAPTER_DIR=
# The port the repo-adapter listens on; its healthcheck and the default REPO_ADAPTER_URL follow it.
# REPO_ADAPTER_PORT=8081
# A PEM bundle added to the system bundle, for a repository behind a private CA.
# Mount the bundle into the repo-adapter (and uc) and point this at it. See docs/getting-started/airgapped.md#repository-behind-a-private-ca.
# REPO_CA_FILE=/etc/ssl/uc-repo-ca.crt
# Archives larger than this are skipped and reported.
# REPO_MAX_ARCHIVE_MB=512

# ---- Downloads ----
# mirror (the get.jenkins.io layout) or artifactory (any Maven-layout repository).
# DOWNLOAD_BACKEND=artifactory
# Where /download/ requests go: https://get.jenkins.io for mirror, the repository (${REPO_URL}${REPO_KEY}; Artifact Keeper ${REPO_URL}maven/${REPO_KEY}) for artifactory.
# DOWNLOAD_BACKEND_URL=
# redirect sends controllers to the backend; proxy streams each file through the web container.
# Controllers cannot read the repository anonymously? Use proxy. See docs/how-to/proxy-downloads.md.
# DOWNLOAD_ACCESS=redirect
# Proxy mode only: the CA bundle the backend's certificate must verify against.
# Mount the bundle into web and point this at it. See docs/how-to/proxy-downloads.md#backend-with-a-private-ca.
# DOWNLOAD_PROXY_CA_FILE=/etc/ssl/certs/ca-certificates.crt
# Proxy mode only: the file holding username:password for the backend, ${SECRETS_DIR}/download_proxy_auth by default.
# DOWNLOAD_PROXY_AUTH_FILE=

# ---- Upstream data ----
# Where security warnings, suspensions and labels come from: github (upstream at RESOURCES_REF), url (a tarball at RESOURCES_URL) or bundled (the copy in the image).
# RESOURCES_SOURCE=bundled
# The update-center2 branch, tag or commit to read with RESOURCES_SOURCE=github.
# RESOURCES_REF=master
# Required with RESOURCES_SOURCE=url: a tarball containing resources/.
# RESOURCES_URL=https://artifactory.corp.example/artifactory/generic-local/update-center2-master.tar.gz
# With RESOURCES_SOURCE=url, the tarball must match this checksum.
# RESOURCES_SHA256=
# Plugin install counts. Set it empty to skip them; popularity is then 0.
# A copy you procured, to keep popularity. See docs/how-to/keep-upstream-data-fresh.md.
# POPULARITY_JSON_URL=https://artifactory.corp.example/artifactory/generic-local/latestNumbers.json
# A directory listing of the updates/ tool-installer files. Set it empty to skip them.
# A copy you procured, to keep the tool installers. See docs/how-to/keep-upstream-data-fresh.md.
# TOOL_INSTALLERS_URL=https://artifactory.corp.example/artifactory/generic-local/updates/
# status.json marks the resources stale when they are older than this.
# STALE_AFTER_DAYS=30

# ---- Generation ----
# The update site id written into the metadata; it must match the update site id on your controllers.
# UC_ID=default
# Cron expression for regular generation. The scheduler also generates at once when no release is live.
# GENERATE_SCHEDULE=0 */6 * * *
# Tiers are offered for cores released within this many days; 0 means every core a plugin requires.
# 400 behaves like updates.jenkins.io (tiers only for cores released in the last 400 days).
# CORE_AGE_DAYS=0
# Releases kept for rollback.
# RETAIN_RELEASES=5
# A release with fewer plugins is refused.
# MIN_PLUGINS=1
# A release with fewer than this share of the live release's plugins is refused, unless run with uc generate --force.
# MIN_PLUGIN_RATIO=0.9

# ---- Doctor ----
# Cron expression for a read-only uc doctor --record run, which saves the report and its counts in status.json; empty means none.
# DOCTOR_SCHEDULE=30 5 * * *
# uc doctor downloads the POMs and manifests missing from the cache, so it can check every dependency and required core (--fetch).
# DOCTOR_FETCH=false
# The floor for required cores (--since); empty means the oldest core in the repository.
# DOCTOR_SINCE=2.462.1
# uc doctor prints its report as JSON (--json).
# DOCTOR_JSON=false

# ---- Signing ----
# Generation stops when the signing certificate expires within this many days.
# CERTIFICATE_MINIMUM_VALID_DAYS=30
# The organization in the subjects of the certificates uc pki init and uc pki rotate create.
# PKI_ORG=Jenkins Update Center
# Lifetime of the root CA uc pki init creates, in days.
# PKI_ROOT_DAYS=3650
# Lifetime of the signing certificate uc pki init and uc pki rotate issue, in days.
# PKI_SIGNING_DAYS=365

# ---- Web and TLS ----
# With TLS_KEY_FILE, enables HTTPS on port 8443: a path inside the web container.
# TLS_CERT_FILE=
# The private key for TLS_CERT_FILE.
# TLS_KEY_FILE=

# ---- Procurement ----
# Where uc doctor --download-* fetches files from, by Maven path; https://repo.jenkins-ci.org/releases/ by default. Air-gapped, downloads are refused unless it is set.
# PROCUREMENT_SOURCE_URL=

# ---- Testing and evaluation ----
# Allows a localhost or loopback PUBLIC_URL, which controllers on other hosts cannot reach. Not for production.
# ALLOW_LOCAL_PUBLIC_URL=false
# Extra update-center2 arguments appended to every run, for example --max-plugins 25 to cap a trial run.
# UC_EXTRA_ARGS=

# ---- Read by bundled software ----
# The generator's JVM options: heap size (-Xmx6g) and outbound proxy (-Dhttps.proxyHost=... -Dhttps.proxyPort=...).
# JAVA_TOOL_OPTIONS=-Xmx4g -Dhttps.proxyHost=proxy.example.com -Dhttps.proxyPort=3128
# The outbound proxy for everything the generator does not fetch itself. Behind a proxy, set it and the proxy flags in JAVA_TOOL_OPTIONS.
# HTTPS_PROXY=http://proxy.example.com:3128
# As HTTPS_PROXY, for plain-http URLs.
# HTTP_PROXY=
# Hosts to reach directly. With a proxy set, include repo-adapter (and an internal repository host).
# NO_PROXY=repo-adapter
# The Compose files every plain docker compose command uses (on Windows, separate them with ;).
# Its default is compose.yaml alone: uncomment this so plain docker compose uses the air-gapped override.
# COMPOSE_FILE=compose.yaml:compose.airgapped.yaml

# ---- Internal ----
# The data volume.
# UC_DATA_DIR=/data
# The overlay directory, config/overlay/ on the host.
# UC_OVERLAY_DIR=/config/overlay
# The generator, templates and bundled resources in the image.
# UC_APP_DIR=/opt/uc
# Where the secret files are read from.
# SECRETS_DIR=/run/secrets
# The signing key, ${SECRETS_DIR}/update-center.key by default.
# SIGNING_KEY_FILE=
# The signing certificate, ${SECRETS_DIR}/update-center.cert by default.
# SIGNING_CERT_FILE=
# The root CA certificate, ${SECRETS_DIR}/root-ca.crt by default.
# ROOT_CA_FILE=
# The repository account, ${SECRETS_DIR}/repo_username by default.
# REPO_USERNAME_FILE=
# The repository account's password or token, ${SECRETS_DIR}/repo_password by default.
# REPO_PASSWORD_FILE=
# The GitHub user, ${SECRETS_DIR}/github_username by default.
# GITHUB_USERNAME_FILE=
# The GitHub token, ${SECRETS_DIR}/github_token by default.
# GITHUB_TOKEN_FILE=
# The account that can write to the repository, ${SECRETS_DIR}/repo_push_auth by default.
# REPO_PUSH_AUTH_FILE=
# The settings file; a missing file is fine.
# UC_CONFIG_FILE=/config/uc.toml

# ---- Compose ----
# The file every service except web loads as env_file.
# UC_ENV_FILE=.env
# The image for uc, scheduler, repo-adapter, web-config and setup.
# UC_IMAGE=jenkins-uc/uc:local
# The image for web.
# WEB_IMAGE=jenkins-uc/web:local
# Host port published for the web container's HTTP listener.
# HTTP_PORT=8080
# Host port published for the web container's TLS listener.
# HTTPS_PORT=8443
