# ShellCheck configuration - applies to every shellcheck run in this tree (it walks up to find
# this file). See https://github.com/koalaman/shellcheck/wiki/Directive.
#
# NOTE: `--color` has no rc-file equivalent (it's CLI-only), so color is set on the invocations
# (e.g. `--color=always` in the pre-commit hook); only the linting rules live here.
#
# Covers every shell script in the tree: the hook matches `types: [shell]`, so a script added later
# is checked with no change here.

enable=all       # opt into every optional check (SC2250 brace refs, SC2312 masked returns, ...)
severity=style   # report down to the lowest (style) level
