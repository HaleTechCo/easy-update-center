// Procurement with an approval before anything is pushed (docs/how-to/run-procurement-from-a-pipeline.md).
// Runs on an agent on the update center's Docker host (label uc-host), in the deployment directory
// UC_DIR, which holds .env and secrets/. Triggered by hand; one run at a time, as the
// staging folder is shared. A run that stages nothing skips the review and every stage after it.
pipeline {
    agent none
    options {
        disableConcurrentBuilds()
    }
    parameters {
        string(name: 'UC_DIR', defaultValue: '/opt/easy-update-center', description: 'The update center deployment directory on the uc-host agent')
    }
    // triggers { cron('H 6 * * 1') } // weekly, on Monday morning
    stages {
        stage('check') {
            agent { label 'uc-host' }
            steps {
                dir(params.UC_DIR) {
                    sh 'docker compose run --rm --no-deps uc config --check'
                    script {
                        // Exit 1 means there is something to procure, which is what this pipeline is for.
                        int rc = sh(script: 'docker compose run --rm uc doctor', returnStatus: true)
                        if (rc > 1) {
                            error("the repository check failed (exit ${rc})")
                        }
                    }
                }
            }
        }
        stage('stage') {
            agent { label 'uc-host' }
            steps {
                dir(params.UC_DIR) {
                    // The checksum of the staged list is what the reviewers approve: the push stage refuses a changed list.
                    // A failed stage still copies what it staged, so the reviewers can read why.
                    sh """#!/bin/bash
                        set -eo pipefail
                        rm -f '${env.WORKSPACE}/stage-report.txt' '${env.WORKSPACE}/procurement.json' '${env.WORKSPACE}/procurement.sha256'
                        rc=0
                        docker compose run --rm uc procure stage 2>&1 | tee '${env.WORKSPACE}/stage-report.txt' || rc=\$?
                        if [ -e procurement/procurement.json ]; then
                            cp procurement/procurement.json '${env.WORKSPACE}/'
                            sha256sum procurement/procurement.json > '${env.WORKSPACE}/procurement.sha256'
                        fi
                        exit "\$rc"
                    """
                }
                stash name: 'reviewed', includes: 'procurement.sha256'
                script {
                    // uc procure stage prints its "next: review" line only when procurement.json lists files.
                    env.UC_STAGED = sh(script: "grep -q '^next: review' stage-report.txt && echo true || echo false", returnStdout: true).trim()
                    if (env.UC_STAGED != 'true') {
                        echo 'Nothing was staged, so there is nothing to review or push: the later stages are skipped.'
                    }
                }
            }
            post {
                always {
                    archiveArtifacts artifacts: 'stage-report.txt, procurement.json, procurement.sha256', allowEmptyArchive: true
                }
            }
        }
        stage('review') {
            // Without anything staged, no one is asked to approve.
            when {
                expression { env.UC_STAGED == 'true' }
            }
            steps {
                // Reviewers read the archived stage-report.txt and procurement.json first;
                // the push stage checks procurement.sha256 against the staged list.
                input message: 'Push the staged files to the repository?', ok: 'Push', submitter: 'uc-approvers'
            }
        }
        stage('push') {
            agent { label 'uc-host' }
            when {
                beforeAgent true
                expression { env.UC_STAGED == 'true' }
            }
            steps {
                unstash 'reviewed'
                dir(params.UC_DIR) {
                    // Stop if procurement.json changed since the review.
                    sh """#!/bin/bash
                        set -eo pipefail
                        sha256sum -c '${env.WORKSPACE}/procurement.sha256'
                        docker compose run --rm uc procure push
                    """
                }
            }
        }
        stage('generate') {
            agent { label 'uc-host' }
            when {
                beforeAgent true
                expression { env.UC_STAGED == 'true' }
            }
            steps {
                dir(params.UC_DIR) {
                    sh 'docker compose run --rm uc generate'
                }
            }
        }
        stage('verify') {
            agent { label 'uc-host' }
            when {
                beforeAgent true
                expression { env.UC_STAGED == 'true' }
            }
            steps {
                dir(params.UC_DIR) {
                    sh 'docker compose run --rm uc status'
                    script {
                        int rc = sh(script: 'docker compose run --rm uc doctor', returnStatus: true)
                        if (rc > 1) {
                            error("the repository check failed (exit ${rc})")
                        }
                    }
                }
            }
        }
        stage('clean') {
            agent { label 'uc-host' }
            when {
                beforeAgent true
                expression { env.UC_STAGED == 'true' }
            }
            steps {
                dir(params.UC_DIR) {
                    sh 'docker compose run --rm uc procure clean'
                }
            }
        }
    }
}
